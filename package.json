{
  "name": "onedrive-cloudflare-index",
  "version": "3.6.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --no-inline-config",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "cloudflare:build": "opennextjs-cloudflare build --skipWranglerConfigCheck",
    "cloudflare:preview": "npm run cloudflare:build && opennextjs-cloudflare preview",
    "cloudflare:deploy": "npm run cloudflare:build && opennextjs-cloudflare deploy",
    "format": "prettier 'src/**/*.{js,ts,jsx,tsx}' --write"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20260901.1",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@headlessui/react": "^2.2.9",
    "@opennextjs/cloudflare": "^1.20.5",
    "awesome-debounce-promise": "^2.1.0",
    "axios": "^1.13.6",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.20",
    "emoji-regex": "^10.6.0",
    "jszip": "^3.10.1",
    "mpegts.js": "^1.8.2",
    "next": "^16.3.4",
    "nextjs-progressbar": "^0.0.16",
    "path-browserify": "^1.0.1",
    "plyr": "^3.7.8",
    "plyr-react": "^6.0.0",
    "preview-office-docs": "^1.0.2",
    "react": "^19.2.4",
    "react-async-hook": "^4.0.0",
    "react-audio-player": "^0.17.0",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "react-hotkeys-hook": "^5.2.4",
    "react-markdown": "^10.1.0",
    "react-reader": "^2.0.15",
    "react-syntax-highlighter": "^16.1.1",
    "react-use-system-theme": "^1.1.1",
    "redaxios": "^0.5.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "swr": "^2.4.1",
    "use-clipboard-copy": "^0.2.0",
    "use-constant": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.9.1",
    "eslint-config-next": "^16.3.4",
    "katex": "^0.18.5",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wrangler": "^4.147.0"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "0.9.12"
    }
  },
  "allowScripts": {
    "core-js": true,
    "es5-ext": true,
    "esbuild": true,
    "sharp": true,
    "workerd": true,
    "unrs-resolver": false
  },
  "prettier": {
    "printWidth": 120,
    "arrowParens": "avoid",
    "singleQuote": true,
    "semi": false,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  }
}
